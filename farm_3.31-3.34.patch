@@ -0,0 +1,144 @@
+# -*- coding: utf-8 -*-
+"""3.34: разговоры с барменом (Гаврила, хозяин «Хмельного колоса»). Без графики.
+
+Щелчок по бармену открывает темы: «Как дела?», «Что нового?», «Дай совет», «Расскажи историю».
+Ответы зависят от того, что сейчас в игре: время на часах компьютера, задания на доске, колесо фортуны,
+достижения, глава, песня, призы. Истории идут по порядку (Tavern.talk_story) и потом по кругу.
+"""
+import datetime
+import random
+
+TOPICS = (("mood", "Как дела?"), ("news", "Что нового?"), ("tip", "Дай совет"), ("story", "Расскажи историю"))
+
+MOOD = {
+    "morning": ["Утро доброе! Я только печь растопил — хлеб будет к полудню.",
+                "С утра пораньше? Уважаю. Самые хорошие урожаи — у тех, кто рано встаёт.",
+                "Доброе утро! Кофе нет, его ещё не изобрели. Есть квас."],
+    "day": ["Дела? Кружки моются, бард поёт, гости платят — что ещё надо трактирщику!",
+            "Жарко сегодня. Даже Рыжик ушёл в тень под лавку.",
+            "Хорошо идут дела! Половина деревни сегодня у меня обедала."],
+    "evening": ["Вечер — лучшее время в таверне. Огонь, песни, все свои.",
+                "Устал за день? Садись у очага, ферма и без тебя поработает.",
+                "Вечером у меня полный зал. Бард в ударе, гости поют громче барда."],
+    "night": ["Ночь на дворе, а ты всё не спишь? Фермеры — народ беспокойный.",
+              "Тс-с... Бард уже клюёт носом. Но для тебя кружку найду.",
+              "Ночью белки не бегают. Отдохни и ты — урожай подождёт."],
+}
+MOOD_ANY = ["Да потихоньку! Вот, кружку новую купил — смотри, какая блестящая.",
+            "Спина болит — бочки таскал. Зато погреб полный!",
+            "Всё как обычно: кто-то поёт, кто-то спорит, кто-то спит в углу."]
+
+STORIES = [
+    "Таверну построил мой прадед. Говорят, первым гостем был король — заблудился на охоте и просидел тут три дня.",
+    "Знаешь, почему «Хмельной колос»? Прадед повесил над дверью колос хмеля, а вывеску так и не заказал. Привыкли!",
+    "Был у нас крестьянин с одним кривым зубом. Улыбался так, что вороны с поля разлетались. С тех пор его все "
+    "на поле зовут — пугалом подрабатывать.",
+    "Однажды золотая белка забежала прямо в зал. Полдеревни за ней гонялось — поймал её кот. Отпустил, конечно: "
+    "Рыжик у нас добрый.",
+    "Разбойники как-то пришли и в таверну. Ограбить хотели. Бард заиграл плясовую — так они до утра проплясали "
+    "и ушли, ещё и за пиво заплатили.",
+    "Скупщик урожая раньше ездил на телеге. Потом купил грузовик, а ехать на нём боялся — неделю толкал руками.",
+    "Мельник наш, Фрол, клянётся, что жернов по ночам сам крутится. Я думаю — это мыши. Очень сильные мыши.",
+    "Говорят, далеко на севере есть поле, где круглый год снег. И живут там гномы — ростом с кружку, а работают за "
+    "десятерых.",
+    "Мила, наша певица, пришла сюда босиком с котомкой. Спела одну песню — и я её не отпустил. Лучшее решение в жизни.",
+    "Волынщик Ерёма играл на свадьбе моего деда. И на моей. Сколько ему лет — не знает никто, даже он сам.",
+    "Королевский сборщик податей у меня в долгу: я ему как-то зонтик одолжил. До сих пор не вернул!",
+    "Вот и всё, что я знаю. Хотя... приходи ещё — что-нибудь да вспомню. Таверна полна историй.",
+]
+
+TIPS_ANY = [
+    "Листья — не трать все сразу. Каждая покупка в дереве поднимает цену остальных. Подумай, что тебе нужнее.",
+    "Не тратишь лист — он даёт +2% к доходу. Иногда копить выгоднее, чем покупать.",
+    "Белку лови сразу — золотая убегает быстрее.",
+    "Задания с доски — хорошая подмога, но главное богатство — твои грядки.",
+    "Уходишь надолго? Найми фермеров на все грядки — урожай будет копиться и без тебя.",
+    "Песню барду закажи перед тем, как собирать большой урожай — с ней доход выше.",
+    "Колесо фортуны крутят раз в день. Бесплатно! Грех не крутить.",
+    "Устал — посиди у камина. Ферма работает сама, а ты отдыхаешь.",
+]
+
+
+def part_of_day(now=None):
+    h = (now or datetime.datetime.now()).hour
+    if 5 <= h < 12:
+        return "morning"
+    if 12 <= h < 18:
+        return "day"
+    if 18 <= h < 23:
+        return "evening"
+    return "night"
+
+
+def mood(rnd=random, now=None):
+    return rnd.choice(MOOD[part_of_day(now)] + MOOD_ANY[:1])
+
+
+def news(farm, tavern, rnd=random, today=None):
+    """Что нового: самые полезные новости о делах игрока (первые две)."""
+    from . import achievements as ach
+    from . import wheel as wh
+    out = []
+    ready = tavern.claimable()
+    if ready:
+        out.append(f"На доске тебя ждёт награда: {len(ready)} {_word(len(ready), 'задание', 'задания', 'заданий')} "
+                   "выполнено!")
+    left = [q for q in tavern.daily if q["progress"] < q["target"]]
+    if tavern.daily and not left and not ready:
+        out.append("Все задания на сегодня сделаны. Молодец! Новые повесят в полночь.")
+    elif left:
+        q = min(left, key=lambda q: q["target"] - q["progress"])
+        out.append(f"Ближе всего к концу — «{q['title']}»: осталось {q['target'] - q['progress']}.")
+    w = tavern.weekly
+    if w and not w["claimed"] and w["progress"] < w["target"]:
+        pct = int(100 * w["progress"] / max(1, w["target"]))
+        out.append(f"Задание недели «{w['title']}» сделано на {pct}%.")
+    if tavern.casino_open and wh.can_spin(tavern, today):
+        out.insert(0, "Колесо фортуны сегодня ещё не крутил! Загляни в Игровую.")
+    got = ach.claimable(tavern)
+    if got:
+        out.insert(0, f"Слыхал, у тебя новое достижение! Забери жетоны в «Достижениях» — их {len(got)}.")
+    if farm.song_left > 0:
+        out.append("Бард сейчас играет твою песню — слышишь, как гости притоптывают?")
+    if not out:
+        done = len(tavern.ach_done)
+        out.append(f"Новостей нет — а значит, всё хорошо. Достижений у тебя уже {done} из {len(ach.ACHIEVEMENTS)}.")
+    return " ".join(out[:2])
+
+
+def tip(farm, tavern, rnd=random):
+    """Совет: сначала по делу (что видно в игре), иначе — общий."""
+    from .config import PRIZES
+    out = []
+    if farm.leaves >= 50 and farm.any_tree_affordable():
+        out.append(f"У тебя {farm.leaves} листьев. Не спеши тратить все — каждая покупка в дереве поднимает цену остальных.")
+    if tavern.tokens >= 60 and any(tavern.prize_state(p) == "can" and not (p.get("jackpot") or p.get("achievement"))
+                                   and tavern.tokens >= p["cost"] for p in PRIZES):
+        out.append(f"Жетонов у тебя {tavern.tokens} — на призовой стойке есть что взять. Загляни в «Призы».")
+    if farm.farm_def().get("peasants") and farm.free_peasants() > 0:
+        out.append("У тебя есть свободные помощники — поставь их на грядки, пусть работают!")
+    if not out:
+        return rnd.choice(TIPS_ANY)
+    return rnd.choice(out)
+
+
+def story(tavern):
+    text = STORIES[tavern.talk_story % len(STORIES)]
+    tavern.talk_story += 1
+    return text
+
+
+def answer(topic, farm, tavern, rnd=random):
+    """Ответ бармена на тему. Считается в статистике разговоров (достижение «Свой человек»)."""
+    if topic == "mood":
+        return mood(rnd)
+    if topic == "news":
+        return news(farm, tavern, rnd)
+    if topic == "tip":
+        return tip(farm, tavern, rnd)
+    return story(tavern)
+
+
+def _word(n, one, few, many):
+    from .tavern import plural
+    return plural(n, one, few, many)
